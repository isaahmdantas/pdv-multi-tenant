// Fase 1/2 — fundação + multi-tenant.
// Regras (ADR-0005): IDs cuid(2), Decimal para money (nunca float),
// sem enums nativos (String + union TS + Zod), sem extensões PG.
// Classificação de escopo: TenantScoped (tenantId), StoreScoped (tenantId+storeId),
// itens-filho (tenantId). Ver docs/DATABASE.md §2.
// Prisma 7: url fica em prisma.config.ts (datasource abaixo só declara provider).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid(2))
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores             Store[]
  users              User[]
  roles              Role[]
  permissions        Permission[]
  userRoles          UserRole[]
  userStores         UserStore[]
  rolePermissions    RolePermission[]
  auditLogs          AuditLog[]
  cashRegisters      CashRegister[]
  terminals          Terminal[]
  devices            Device[]
  productCategories  ProductCategory[]
  productBrands      ProductBrand[]
  unitOfMeasures     UnitOfMeasure[]
  unitConversions    UnitConversion[]
  products           Product[]
  productBarcodes    ProductBarcode[]
  productStores      ProductStore[]
  customerCategories CustomerCategory[]
  customers          Customer[]
  priceTables        PriceTable[]
  productPrices      ProductPrice[]
  promotions         Promotion[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  stockTransferItems StockTransferItem[]
  inventories        Inventory[]
  inventoryItems     InventoryItem[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]

  @@index([slug])
  sales                Sale[]
  saleItems            SaleItem[]
}

model Store {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document                  String?
  phone                     String?
  email                     String?
  address                   String?
  city                      String?
  state                     String?
  zipCode                   String?
  timezone                  String            @default("America/Sao_Paulo")
  fiscalState               String?
  fiscalEnvironment         String?
  fiscalEnabled             Boolean           @default(false)
  fiscalSeries              String?
  defaultCustomerCategoryId String?
  defaultCustomerCategory   CustomerCategory? @relation("StoreDefaultCategory", fields: [defaultCustomerCategoryId], references: [id])

  userStores           UserStore[]
  auditLogs            AuditLog[]
  cashRegisters        CashRegister[]
  terminals            Terminal[]
  devices              Device[]
  productStores        ProductStore[]
  priceTables          PriceTable[]
  promotions           Promotion[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  sourceTransfers      StockTransfer[] @relation("StockTransferSource")
  destinationTransfers StockTransfer[] @relation("StockTransferDestination")
  inventories          Inventory[]
  purchases            Purchase[]
  cashSessions         CashSession[]
  cashMovements        CashMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  sales                Sale[]
}

model CashRegister {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashSessions CashSession[]

  @@unique([tenantId, storeId, name])
  @@index([tenantId, storeId])
}

model Terminal {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  code      String
  mode      String   @default("POS")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, storeId])
  sales                Sale[]
}

model Device {
  id         String   @id @default(cuid(2))
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id])
  type       String
  identifier String
  name       String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, type, identifier])
  @@index([tenantId, storeId])
}

model User {
  id           String   @id @default(cuid(2))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles      UserRole[]
  userStores UserStore[]
  auditLogs  AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  sales                Sale[]
}

model Role {
  id                String   @id @default(cuid(2))
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  description       String?
  globalStoreAccess Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  storesRole      UserStore[]      @relation("UserStoreRole")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        String?
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id @default(cuid(2))
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([tenantId])
}

model UserRole {
  id       String @id @default(cuid(2))
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  roleId   String
  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
}

model UserStore {
  id          String   @id @default(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  storeId     String
  storeRoleId String?
  user        User     @relation(fields: [userId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  storeRole   Role?    @relation("UserStoreRole", fields: [storeRoleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, userId, storeId])
  @@index([tenantId, storeId])
}

model AuditLog {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  device    String?
  timestamp DateTime @default(now())

  @@index([tenantId, timestamp])
}

// —— Fase 5 — Produtos ———

model ProductCategory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductBrand {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UnitOfMeasure {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products           Product[]           @relation("ProductBaseUnit")
  conversionsFrom    UnitConversion[]    @relation("UnitConversionFrom")
  conversionsTo      UnitConversion[]    @relation("UnitConversionTo")
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  purchaseItems      PurchaseItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UnitConversion {
  id         String        @id @default(cuid(2))
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  fromUnitId String
  toUnitId   String
  factor     Decimal
  fromUnit   UnitOfMeasure @relation("UnitConversionFrom", fields: [fromUnitId], references: [id])
  toUnit     UnitOfMeasure @relation("UnitConversionTo", fields: [toUnitId], references: [id])
  createdAt  DateTime      @default(now())

  @@unique([tenantId, fromUnitId, toUnitId])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  sku         String
  description String?
  categoryId  String?
  brandId     String?
  baseUnitId  String
  basePrice   Decimal  @default(0)
  status      String   @default("ACTIVE")
  ncm         String?
  cest        String?
  cfop        String?
  isService   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  brand              ProductBrand?       @relation(fields: [brandId], references: [id])
  baseUnit           UnitOfMeasure       @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  barcodes           ProductBarcode[]
  storeLinks         ProductStore[]
  priceRows          ProductPrice[]
  promotions         Promotion[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  inventoryItems     InventoryItem[]
  purchaseItems      PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
  saleItems            SaleItem[]
}

model ProductBarcode {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  value     String
  createdAt DateTime @default(now())

  @@unique([tenantId, value])
  @@index([productId])
  @@index([tenantId])
}

model ProductStore {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("ACTIVE")
  minStock  Decimal  @default(0)
  maxStock  Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, storeId, productId])
  @@index([tenantId, storeId])
  @@index([productId])
}

model CustomerCategory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers    Customer[]
  storeDefault Store[]      @relation("StoreDefaultCategory")
  priceTables  PriceTable[]
  promotions   Promotion[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id                 String    @id @default(cuid(2))
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  name               String
  document           String?
  email              String?
  phone              String?
  birthday           DateTime?
  notes              String?
  customerCategoryId String?
  creditLimit        Decimal   @default(0)
  loyaltyPoints      Int       @default(0)
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  category CustomerCategory? @relation(fields: [customerCategoryId], references: [id])

  @@unique([tenantId, document])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, name])
  sales               Sale[]
}

// —— Fase 7 — Preços ———

model PriceTable {
  id                 String            @id @default(cuid(2))
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  name               String
  description        String?
  storeId            String?
  store              Store?            @relation(fields: [storeId], references: [id])
  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  defaultPrice       Decimal           @default(0)
  priority           Int               @default(0)
  validFrom          DateTime          @default(now())
  validUntil         DateTime?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  productPrices ProductPrice[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, storeId])
  sales             Sale[]
}

model ProductPrice {
  id              String     @id @default(cuid(2))
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  priceTableId    String
  priceTable      PriceTable @relation(fields: [priceTableId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  unitPrice       Decimal
  minimumQuantity Decimal?
  maximumQuantity Decimal?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([priceTableId])
  @@index([productId])
  @@index([tenantId])
}

model Promotion {
  id                 String            @id @default(cuid(2))
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  storeId            String?
  store              Store?            @relation(fields: [storeId], references: [id])
  productId          String?
  product            Product?          @relation(fields: [productId], references: [id])
  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  discountType       String // PERCENTAGE | FIXED
  discountValue      Decimal
  validFrom          DateTime          @default(now())
  validUntil         DateTime?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, storeId])
  @@index([tenantId, productId])
}

// —— Fase 8 — Estoque ———

// Saldo de estoque por unidade. `quantity` é o estoque físico; `reservedQuantity`
// está preparado para reserva de estoque futura (fluxo PDV/vendas) e NÃO é
// movimentado por StockMovement; `availableQuantity = quantity - reservedQuantity`.
// Concorrência (ADR-0005): updates atômicos condicionais + `version` (optimistic),
// nunca SELECT ... FOR UPDATE.
model StockBalance {
  id                String   @id @default(cuid(2))
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Decimal  @default(0)
  reservedQuantity  Decimal  @default(0)
  availableQuantity Decimal  @default(0)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, storeId, productId])
  @@index([tenantId])
  @@index([tenantId, storeId])
  @@index([productId])
}

// Movimentação de estoque (histórico por unidade). `quantity` é sempre na unidade
// base do produto; `quantityInUnit` + `unitOfMeasureId` guardam a unidade em que o
// movimento foi efetivamente registrado (ex.: entrada 2 CX → base 24 UN).
model StockMovement {
  id              String         @id @default(cuid(2))
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  type            String // IN | OUT | ADJUST | TRANSFER_IN | TRANSFER_OUT
  quantity        Decimal
  quantityInUnit  Decimal?
  unitOfMeasureId String?
  unitOfMeasure   UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  balanceAfter    Decimal
  reason          String?
  referenceType   String? // SALE | PURCHASE | INVENTORY | TRANSFER
  referenceId     String?
  createdBy       String?
  createdAt       DateTime       @default(now())

  @@index([tenantId, storeId, productId, createdAt])
  @@index([tenantId])
  @@index([tenantId, productId])
}

// Transferência entre unidades com múltiplos produtos (itens). Concluída em uma
// única transação atômica na F8; `status` está preparado para evolução futura de
// workflow SOLICITADA → SEPARADA → EXPEDIDA → RECEBIDA.
model StockTransfer {
  id                 String    @id @default(cuid(2))
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  storeId            String
  store              Store     @relation("StockTransferSource", fields: [storeId], references: [id])
  destinationStoreId String
  destinationStore   Store     @relation("StockTransferDestination", fields: [destinationStoreId], references: [id])
  status             String    @default("COMPLETED")
  reason             String?
  createdBy          String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  items StockTransferItem[]

  @@index([tenantId])
  @@index([tenantId, storeId])
  @@index([tenantId, destinationStoreId])
}

model StockTransferItem {
  id              String         @id @default(cuid(2))
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  transferId      String
  transfer        StockTransfer  @relation(fields: [transferId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Decimal
  quantityInUnit  Decimal?
  unitOfMeasureId String?
  unitOfMeasure   UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([transferId, productId])
  @@index([transferId])
  @@index([productId])
}

// Inventário (contagem de estoque). OPEN enquanto conta; ao fechar grava
// `difference = countedQuantity - expectedQuantity` e aplica o delta como ADJUST
// referenciando o inventário.
model Inventory {
  id         String    @id @default(cuid(2))
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  status     String    @default("OPEN")
  notes      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  items InventoryItem[]

  @@index([tenantId])
  @@index([tenantId, storeId])
}

model InventoryItem {
  id               String    @id @default(cuid(2))
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  inventoryId      String
  inventory        Inventory @relation(fields: [inventoryId], references: [id])
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  expectedQuantity Decimal
  countedQuantity  Decimal?
  difference       Decimal?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([inventoryId, productId])
  @@index([inventoryId])
  @@index([productId])
}

// ——— Fase 9 — Compras ———

// Fornecedor do tenant (TenantScoped). `document` (CNPJ/CPF) é único por tenant;
// opcional para fornecedores informais. Isolado por repositório (tenantId).
model Supplier {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  notes     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([tenantId, name])
}

// Pedido de compra (StoreScoped). `status`: ORDERED → RECEIVED | CANCELLED.
// `totalAmount` = soma dos `totalCost` dos itens (custo da mercadoria, sem impostos).
// Ao receber, os itens geram StockMovement IN com `referenceType = PURCHASE`
// (integração estoque F8) e a compra passa a RECEIVED.
model Purchase {
  id         String     @id @default(cuid(2))
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id])
  supplierId String?
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  status     String     @default("ORDERED")
  totalAmount Decimal   @default(0)
  notes      String?
  expectedAt DateTime?
  receivedAt DateTime?
  createdBy  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items PurchaseItem[]

  @@index([tenantId])
  @@index([tenantId, storeId])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

// Item do pedido (itens-filho: apenas `tenantId`, sem `storeId`). `quantity` na
// unidade do pedido; ao receber, `unitOfMeasureId`/`quantityInUnit` gravam a unidade
// efetiva e `quantity` na unidade base é o StockMovement (integração F8). `unitCost`
// e `totalCost` = custo unitário/total da mercadoria (F9-04). `batchNumber` (lote,
// F9-05) e `expiryDate` (validade, F9-06) registrados na entrada.
model PurchaseItem {
  id              String         @id @default(cuid(2))
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  purchaseId      String
  purchase        Purchase       @relation(fields: [purchaseId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Decimal
  quantityInUnit  Decimal?
  unitOfMeasureId String?
  unitOfMeasure   UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  unitCost        Decimal
  totalCost       Decimal
  batchNumber     String?
  expiryDate      DateTime?
  createdAt       DateTime       @default(now())

  @@unique([purchaseId, productId])
  @@index([purchaseId])
  @@index([productId])
  @@index([tenantId])
}

// ——— Fase 10 — Caixa ———

// Sessão de caixa (StoreScoped). `status`: OPEN → CLOSED.
// `openingAmount` = valor inicial (suprimento inicial). `closingAmount` = soma esperada
// (opening + vendas + suprimentos - sangrias). No fechamento, recebe `countedByMethod`
// e calcula `difference` + `classification` (EXACT/SURPLUS/SHORTAGE).
model CashSession {
  id             String       @id @default(cuid(2))
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  openedBy       String
  status         String       @default("OPEN")
  openingAmount  Decimal      @default(0)
  closingAmount  Decimal?
  difference     Decimal?
  classification String?      // EXACT | SURPLUS | SHORTAGE
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  movements CashMovement[]

  @@index([tenantId, storeId])
  @@index([tenantId, storeId, status])
  @@index([tenantId, cashRegisterId])
  sales              Sale[]
}

// Movimentação de caixa (StoreScoped). `type`: OPENING | SALE | SUPPLY | WITHDRAW | CLOSING | ADJUSTMENT.
// `referenceType`/`referenceId` ligam a Sale, Purchase, etc. (futuro).
// `methodCode` (CASH, PIX, CREDIT, DEBIT, VOUCHER) para movimentos de entrada/saída.
model CashMovement {
  id              String   @id @default(cuid(2))
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  cashSessionId   String
  cashSession     CashSession @relation(fields: [cashSessionId], references: [id])
  type            String
  methodCode      String?
  amount          Decimal
  notes           String?
  referenceType   String?
  referenceId     String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([tenantId, storeId])
  @@index([tenantId, cashSessionId])
  @@index([tenantId, cashSessionId, type])
}

// ——— Fase 11 — Vendas (PDV) ———

// Venda de PDV (StoreScoped). `status`: COMPLETED | CANCELLED.
// `subtotal` = soma dos itens; `discount` = desconto total aplicado; `total` = final.
// `terminalId` = terminal POS (F5) que executou a venda; `cashSessionId` = sessão de caixa aberta (F10),
// que receberá um CashMovement type=SALE no pagamento (F11/F12). `priceTableId` = tabela aplicada via PricingService (F7).
// Preços NUNCA são recalculados aqui: o PDV chama PricingService (F7). Estoque SÓ é baixado no
// fechamento da venda via StockService (F8) — o carrinho NÃO decrementa.
model Sale {
  id             String        @id @default(cuid(2))
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  terminalId     String?
  terminal       Terminal?     @relation(fields: [terminalId], references: [id])
  cashSessionId  String?
  cashSession    CashSession?  @relation(fields: [cashSessionId], references: [id])
  operatorId     String
  operator       User          @relation(fields: [operatorId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  priceTableId   String?
  priceTable     PriceTable?   @relation(fields: [priceTableId], references: [id])
  clientOperationId String?    @db.VarChar(64)
  status         String        @default("COMPLETED")
  subtotal       Decimal       @default(0)
  discount       Decimal       @default(0)
  total          Decimal       @default(0)
  // F12-07: total já estornado (soma dos CashMovement REFUND da venda).
  refundedTotal  Decimal       @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items SaleItem[]

  @@index([tenantId, storeId])
  @@index([tenantId, cashSessionId])
  @@index([tenantId, terminalId])
  @@unique([tenantId, clientOperationId])
}

model SaleItem {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @default(0)
  unitPrice Decimal  @default(0)
  discount  Decimal  @default(0)
  total     Decimal  @default(0)
  priceTableId String?
  promotionId  String?
  // F12-07: quantidade já estornada deste item (estorno parcial).
  refundedQuantity Decimal @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, saleId])
}
