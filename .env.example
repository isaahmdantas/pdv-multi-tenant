# Copie para .env e ajuste conforme o ambiente.
DATABASE_URL="postgresql://USER:SENHA@localhost:5432/pdv?schema=public"

# Banco usado pelos testes de integração (isolamento A x B).
# Crie com: createdb -U postgres pdv_test
# Aplique migrations com: DATABASE_URL="postgresql://postgres@localhost:5432/pdv_test?schema=public" npx prisma migrate deploy
DATABASE_URL_TEST="postgresql://postgres@localhost:5432/pdv_test?schema=public"

