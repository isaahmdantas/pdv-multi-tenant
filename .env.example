# Copie para .env e ajuste conforme o ambiente.
DATABASE_URL="postgresql://USER:SENHA@localhost:5432/pdv?schema=public"

# Banco usado pelos testes de integração (isolamento A x B).
# Crie com: createdb -U postgres pdv_test
# Aplique migrations com: DATABASE_URL="postgresql://postgres@localhost:5432/pdv_test?schema=public" npx prisma migrate deploy
DATABASE_URL_TEST="postgresql://postgres@localhost:5432/pdv_test?schema=public"

# Auth.js (Fase 3). Gere com: openssl rand -base64 32
AUTH_SECRET=""
# URL pública da aplicação (http://localhost:3000 em dev).
# Com AUTH_URL http:// o cookie da sessão fica sem o prefixo __Secure-
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# Script de seed (scripts/seed.ts) — opcionais.
# SEED_TENANT_SLUG="loja-demo"
# SEED_TENANT_NAME="Loja Demo"
# SEED_STORE_CODE="MATRIZ"
# SEED_STORE_NAME="Matriz"
# SEED_ADMIN_EMAIL="admin@loja.local"
# SEED_ADMIN_PASSWORD="admin12345"