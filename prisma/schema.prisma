// Fase 1/2 — fundação + multi-tenant.
// Regras (ADR-0005): IDs cuid(2), Decimal para money (nunca float),
// sem enums nativos (String + union TS + Zod), sem extensões PG.
// Classificação de escopo: TenantScoped (tenantId), StoreScoped (tenantId+storeId),
// itens-filho (tenantId). Ver docs/DATABASE.md §2.
// Prisma 7: url fica em prisma.config.ts (datasource abaixo só declara provider).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid(2))
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores             Store[]
  users              User[]
  roles              Role[]
  permissions        Permission[]
  userRoles          UserRole[]
  userStores         UserStore[]
  rolePermissions    RolePermission[]
  auditLogs          AuditLog[]
  cashRegisters      CashRegister[]
  terminals          Terminal[]
  devices            Device[]
  productCategories  ProductCategory[]
  productBrands      ProductBrand[]
  unitOfMeasures     UnitOfMeasure[]
  unitConversions    UnitConversion[]
  products           Product[]
  productBarcodes    ProductBarcode[]
  productStores      ProductStore[]
  customerCategories CustomerCategory[]
  customers          Customer[]
  priceTables        PriceTable[]
  productPrices      ProductPrice[]
  promotions         Promotion[]

  @@index([slug])
}

model Store {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document                  String?
  phone                     String?
  email                     String?
  address                   String?
  city                      String?
  state                     String?
  zipCode                   String?
  timezone                  String            @default("America/Sao_Paulo")
  fiscalState               String?
  fiscalEnvironment         String?
  fiscalEnabled             Boolean           @default(false)
  fiscalSeries              String?
  defaultCustomerCategoryId String?
  defaultCustomerCategory   CustomerCategory? @relation("StoreDefaultCategory", fields: [defaultCustomerCategoryId], references: [id])

  userStores    UserStore[]
  auditLogs     AuditLog[]
  cashRegisters CashRegister[]
  terminals     Terminal[]
  devices       Device[]
  productStores ProductStore[]
  priceTables   PriceTable[]
  promotions    Promotion[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CashRegister {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, storeId, name])
  @@index([tenantId, storeId])
}

model Terminal {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  code      String
  mode      String   @default("POS")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, storeId])
}

model Device {
  id         String   @id @default(cuid(2))
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id])
  type       String
  identifier String
  name       String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, type, identifier])
  @@index([tenantId, storeId])
}

model User {
  id           String   @id @default(cuid(2))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles      UserRole[]
  userStores UserStore[]
  auditLogs  AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id                String   @id @default(cuid(2))
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  description       String?
  globalStoreAccess Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  storesRole      UserStore[]      @relation("UserStoreRole")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        String?
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id @default(cuid(2))
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([tenantId])
}

model UserRole {
  id       String @id @default(cuid(2))
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  roleId   String
  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
}

model UserStore {
  id          String   @id @default(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  storeId     String
  storeRoleId String?
  user        User     @relation(fields: [userId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  storeRole   Role?    @relation("UserStoreRole", fields: [storeRoleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, userId, storeId])
  @@index([tenantId, storeId])
}

model AuditLog {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  device    String?
  timestamp DateTime @default(now())

  @@index([tenantId, timestamp])
}

// —— Fase 5 — Produtos ———

model ProductCategory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductBrand {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UnitOfMeasure {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products        Product[]        @relation("ProductBaseUnit")
  conversionsFrom UnitConversion[] @relation("UnitConversionFrom")
  conversionsTo   UnitConversion[] @relation("UnitConversionTo")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UnitConversion {
  id         String        @id @default(cuid(2))
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  fromUnitId String
  toUnitId   String
  factor     Decimal
  fromUnit   UnitOfMeasure @relation("UnitConversionFrom", fields: [fromUnitId], references: [id])
  toUnit     UnitOfMeasure @relation("UnitConversionTo", fields: [toUnitId], references: [id])
  createdAt  DateTime      @default(now())

  @@unique([tenantId, fromUnitId, toUnitId])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  sku         String
  description String?
  categoryId  String?
  brandId     String?
  baseUnitId  String
  basePrice   Decimal  @default(0)
  status      String   @default("ACTIVE")
  ncm         String?
  cest        String?
  cfop        String?
  isService   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  brand      ProductBrand?    @relation(fields: [brandId], references: [id])
  baseUnit   UnitOfMeasure    @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  barcodes   ProductBarcode[]
  storeLinks ProductStore[]
  priceRows  ProductPrice[]
  promotions Promotion[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
}

model ProductBarcode {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  value     String
  createdAt DateTime @default(now())

  @@unique([tenantId, value])
  @@index([productId])
  @@index([tenantId])
}

model ProductStore {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, storeId, productId])
  @@index([tenantId, storeId])
  @@index([productId])
}

model CustomerCategory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers    Customer[]
  storeDefault Store[]      @relation("StoreDefaultCategory")
  priceTables  PriceTable[]
  promotions   Promotion[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id                 String    @id @default(cuid(2))
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  name               String
  document           String?
  email              String?
  phone              String?
  birthday           DateTime?
  notes              String?
  customerCategoryId String?
  creditLimit        Decimal   @default(0)
  loyaltyPoints      Int       @default(0)
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  category CustomerCategory? @relation(fields: [customerCategoryId], references: [id])

  @@unique([tenantId, document])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, name])
}

// —— Fase 7 — Preços ———

model PriceTable {
  id                 String            @id @default(cuid(2))
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  name               String
  description        String?
  storeId            String?
  store              Store?            @relation(fields: [storeId], references: [id])
  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  defaultPrice       Decimal           @default(0)
  priority           Int               @default(0)
  validFrom          DateTime          @default(now())
  validUntil         DateTime?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  productPrices ProductPrice[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, storeId])
}

model ProductPrice {
  id              String     @id @default(cuid(2))
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  priceTableId    String
  priceTable      PriceTable @relation(fields: [priceTableId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  unitPrice       Decimal
  minimumQuantity Decimal?
  maximumQuantity Decimal?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([priceTableId])
  @@index([productId])
  @@index([tenantId])
}

model Promotion {
  id                 String            @id @default(cuid(2))
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  storeId            String?
  store              Store?            @relation(fields: [storeId], references: [id])
  productId          String?
  product            Product?          @relation(fields: [productId], references: [id])
  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  discountType       String // PERCENTAGE | FIXED
  discountValue      Decimal
  validFrom          DateTime          @default(now())
  validUntil         DateTime?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, storeId])
  @@index([tenantId, productId])
}
